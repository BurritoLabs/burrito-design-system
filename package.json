{
  "name": "@burritolabs/ui",
  "version": "0.1.0",
  "description": "Shared Burrito brand assets, design tokens, themes, and React UI primitives.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "brand",
    "concepts",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./theme-script": {
      "types": "./dist/theme-script.d.ts",
      "import": "./dist/theme-script.js",
      "require": "./dist/theme-script.cjs"
    },
    "./tokens.css": "./dist/tokens.css",
    "./brand/icon-64.png": "./brand/icon-64.png",
    "./brand/icon-192.png": "./brand/icon-192.png",
    "./brand/icon-1024.png": "./brand/icon-1024.png"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-static.mjs",
    "typecheck": "tsc --noEmit",
    "validate:tokens": "node scripts/validate-tokens.mjs",
    "check": "npm run typecheck && npm run validate:tokens && npm run build",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BurritoLabs/burrito-design-system.git"
  },
  "license": "UNLICENSED"
}
